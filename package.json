{
  "name": "voxelgame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fully destructible 3D voxel sandbox where every voxel is simulated.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
